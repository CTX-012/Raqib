# edge_monitor configuration
#
# Defaults bias toward safety: the allowlist covers shells and init, the
# SIGTERM grace period is 5s, and the rate limiter caps automated kills.
# Manual kills require explicit kill_confirm card confirmation in the
# TUI (UX_CONTRACT §6 / CAR-17). Uncomment and edit only the fields you
# want to override.

[runtime]
# How often to sample /proc, classify, and let the governor decide.
tick_interval_ms = 1000
# UI redraw rate. Renders cached state between samples.
render_interval_ms = 100
# In-memory ring buffers for the Completed and Audit panels.
completed_history = 50
audit_history = 100

[policy]
# Process names that are NEVER killed by the automated governor.
# Manual kills still respect this list (UI prompts for explicit confirm).
allowlist = [
    "systemd",
    "init",
    "sshd",
    "bash",
    "zsh",
    "sh",
    "kworker",
    "kthreadd",
]

# Process names that the governor always treats as kill candidates.
blocklist = []

# Default action for AI-classified processes that match neither list.
# "Allow" or "Kill". Kill is recommended; the rate limiter + allowlist
# are the safety knobs that keep an automated misfire from cascading.
default_ai_action = "Kill"

# Seconds between SIGTERM and SIGKILL for any single process. Minimum 1s.
sigterm_grace_secs = 5

[storage]
# Directory holding per-day RunRecord JSONL plus a tiny index file.
# `~/` expands to $HOME. Set to "" to disable persistence (in-memory only —
# the history subcommand and regression detector both go silent).
run_store_path = "~/.local/share/edge_monitor"

# Hash cache so the model fingerprinter doesn't re-read GB-sized weight
# files on every exit. "" disables caching (every fingerprint recomputes
# from scratch).
fingerprint_cache = "~/.cache/edge_monitor/fingerprints.json"

# Hard cap on retained runs per model. Older entries are pruned. Set
# higher if you want a longer baseline window for regression detection.
keep_runs_per_model = 200

[regression]
# Percent threshold for a "Warn" regression. A run that's ≥ warn_pct %
# worse than the baseline mean on any tracked metric raises a warning.
warn_pct = 10.0

# Percent threshold for a "Critical" regression. Must be ≥ warn_pct.
critical_pct = 25.0

# Number of prior runs (per model) used to compute the baseline mean
# when comparing a new exit. A larger window stabilises the baseline at
# the cost of slower drift detection.
baseline_window = 10

# Minimum number of historical runs required before regression detection
# fires. Below this the detector stays silent — small samples produce
# noisy false-positives. Set to u32::MAX (4294967295) to disable
# regression detection without removing this section.
min_baseline_samples = 3

# Per-metric central-tendency strategy used to compute the baseline
# (latest.md F.3.8). "mean" is the historical default and is right when
# baseline runs are tightly clustered. "median" is robust to a single
# bad run and is right for noisy baselines (canary fleets, dev boxes,
# freshly imported data). Validated case-insensitively at load time.
baseline_strategy = "mean"

# Drop runs whose key metric is >2σ from the median before computing
# the baseline. The flagged ids still surface on
# `Baseline.outlier_run_ids` so a reviewer can see them. Default false
# (historical). Setting true is most useful with `baseline_strategy =
# "median"` on noisy fleets.
drop_outliers = false

[telemetry]
# Toggles for the optional samplers driven by `telemetry::Dispatcher`.
# All on by default; sampling is cheap on idle (HTTP scrapers fail fast
# on connection refused) and the dispatcher's `applies_to` gate keeps
# non-AI processes from being touched.

# vLLM Prometheus scraper (latest.md Tier 1.2a). Detects vllm processes
# by cmdline (`vllm serve`, `vllm.entrypoints.*`, `python -m vllm`) or
# `VLLM_*` env vars; scrapes `http://127.0.0.1:<port>/metrics`. Set
# `false` to disable on hosts that never run vLLM.
vllm_scrape = true

# llama.cpp `llama-server` scraper (latest.md Tier 1.2b). Same shape as
# vLLM, defaults to port 8080. Set `false` to disable.
llamacpp_scrape = true

# Ollama `/api/ps` poller (latest.md Tier 1.2c). Confirms which model
# is loaded so the dispatcher can promote the model name onto the
# RunRecord even when the classifier saw only `ollama runner`.
ollama_api = true

# Built-in Prometheus exporter (latest.md Tier 2.3). Empty string
# disables; otherwise `host:port` (e.g. "127.0.0.1:9472"). Bind to
# loopback and put a reverse proxy in front for auth / TLS — the
# exporter does no auth itself. Disabled by default.
prometheus_bind = ""

# Vision probe Unix-domain socket (latest.md Tier 3.6). Empty disables;
# otherwise a filesystem path the vision-inference loop can connect to
# and push line-delimited `{"pid": <u32>, "frame_at_ns": <u64>}` JSON
# events. Each event aggregates into a per-PID rolling 1s window and
# instantaneous fps flows into the telemetry accumulator. Disabled by
# default.
vision_probe_socket = ""

[ui]
# Color theme (UX_CONTRACT.md §13). One of "dark" (default), "light", or
# "high-contrast" / "high_contrast". Case-insensitive. The CLI flag
# `--theme <name>` overrides this for a single launch. Unknown values
# fall back to "dark" at render time so an unrecognised theme name
# doesn't refuse to start the TUI.
theme = "dark"
