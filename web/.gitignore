node_modules/
# Ignore built assets under dist/ (they're generated by `npm run
# build`) but track the folder itself via .gitkeep so that a fresh
# clone has web/dist/ present. rust-embed's derive macro reads that
# folder at compile time; if it's missing entirely, the derive fails
# to compile (see src/web/assets.rs). With the folder present but
# empty, the derive produces an empty impl and the runtime falls
# back to the "Frontend not built" placeholder per the assets.rs
# doc-comment.
dist/*
!dist/.gitkeep
.svelte-kit/
*.log
